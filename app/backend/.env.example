# COPY TO .env AND REPLACE PLACEHOLDERS LOCALLY. Never commit .env.
# Create an empty development database and a dedicated PostgreSQL role first.
# URL-encode special characters in database credentials.
AUTOCARE_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@127.0.0.1:5432/autocare_recovery_dev
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# This placeholder is intentionally rejected by application validation.
AUTOCARE_SECRET_KEY=CHANGE_ME_GENERATE_A_UNIQUE_RANDOM_SECRET
AUTOCARE_HOST=127.0.0.1
AUTOCARE_PORT=18080
AUTOCARE_COOKIE_SECURE=false
AUTOCARE_DISABLE_SCHEDULER=true
# Optional: path containing pg_dump and pg_restore (needed for backup operations).
# AUTOCARE_PG_BIN_DIR=C:\Program Files\PostgreSQL\REPLACE_VERSION\bin
# Optional: keep runtime storage outside the source checkout.
# AUTOCARE_STORAGE_DIR=C:\AutoCarePro-DevData
# Optional HTTPS: provide both, then use HTTPS and secure cookies.
# AUTOCARE_SSL_CERTFILE=C:\AutoCarePro-DevData\certs\autocare.crt
# AUTOCARE_SSL_KEYFILE=C:\AutoCarePro-DevData\certs\autocare.key
# Demo seeding only: supply AUTOCARE_DEMO_PASSWORD privately in the process
# environment, then clear it. There is no default; do not commit a real value.
